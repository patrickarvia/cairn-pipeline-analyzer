# HubSpot read-only OAuth integration
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://cairn-pipeline-analyzer.vercel.app/api/hubspot/callback
HUBSPOT_APP_URL=https://cairn-pipeline-analyzer.vercel.app
# Generate a long random value (32+ bytes recommended). Never commit the real secret.
HUBSPOT_COOKIE_SECRET=

# Salesforce External Client App OAuth (PKCE web server flow)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=https://cairn-pipeline-analyzer.vercel.app/api/salesforce/callback
SALESFORCE_APP_URL=https://cairn-pipeline-analyzer.vercel.app
# Optional: https://test.salesforce.com for sandbox organizations
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Generate an independent 32+ byte secret; never commit the real value.
SALESFORCE_COOKIE_SECRET=
